#include <stdio.h>
int main() {
    int n,i,t=0,done=0,k;
    int at[10],bt[10],rt[10],pr[10],ct[10];

    printf("Enter number of processes: ");
    scanf("%d",&n);

    for(i=0;i<n;i++) {
        printf("Enter AT, BT, Priority for P%d: ",i+1);
        scanf("%d%d%d",&at[i],&bt[i],&pr[i]);
        rt[i]=bt[i];
    }

    while(done<n) {
        k=-1;
        for(i=0;i<n;i++)
            if(at[i]<=t && rt[i]>0 &&
               (k==-1 || pr[i]<pr[k]))
                k=i;

        if(k==-1) { t++; continue; }

        rt[k]--;
        t++;

        if(rt[k]==0) {
            ct[k]=t;
            done++;
        }
    }

    printf("\nProcess\tCT\tWT\tTAT\n");
    for(i=0;i<n;i++) {
        int tat=ct[i]-at[i];
        int wt=tat-bt[i];
        printf("P%d\t%d\t%d\t%d\n",i+1,ct[i],wt,tat);
    }
    return 0;
}
