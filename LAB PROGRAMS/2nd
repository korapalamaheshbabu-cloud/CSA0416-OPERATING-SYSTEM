#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int in, out, n;
    char buf[100];

    in = open("input.txt", O_RDONLY);
    out = open("output.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    while ((n = read(in, buf, sizeof(buf))) > 0)
        write(out, buf, n);

    close(in);
    close(out);

    printf("File copied successfully.\n");
    return 0;
}
